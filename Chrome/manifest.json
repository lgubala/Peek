{
  "manifest_version": 3,
  "name": "Peek",
  "version": "1.5.0",
  "description": "Read a link before you open it. Peek shows what is actually on the other side, without opening the page.",
  "homepage_url": "https://github.com/lgubala/Peek",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/platform/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/common/log.js",
        "src/config/rules.js",
        "src/config/sites.js",
        "src/platform/dom.js",
        "src/common/text.js",
        "src/common/url.js",
        "src/common/policy.js",
        "src/link/tld.js",
        "src/link/recognizers.js",
        "src/link/nav.js",
        "src/link/analyze.js",
        "src/content/styles.js",
        "src/content/settings.js",
        "src/content/card.js",
        "src/content/hover.js",
        "src/content/index.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Peek",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
