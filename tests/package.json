{
  "name": "peek",
  "version": "1.19.0",
  "description": "Read a link before you open it. A Firefox and Chrome extension.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/lgubala/Peek",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node tests/run.js",
    "syntax": "find src platform tests -name '*.js' -exec node --check {} +",
    "verify": "npm run syntax && npm run check && npm test"
  },
  "devDependencies": {
    "jsdom": "^24.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
